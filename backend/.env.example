# Copier ce fichier en « .env » (ignoré par Git) et renseigner les valeurs.

# Signe les JWT des abonnés. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Secret partagé compteur <-> backend (signature HMAC-SHA256 des télémétries)
VIRUNGA_IOT_HMAC_SECRET=

# Paiements (laisser vide : l'initiation répond 503, aucun paiement n'est simulé)
PAWAPAY_SANDBOX_TOKEN=
FLUTTERWAVE_SECRET_KEY=
FLW_SECRET_HASH=

# --- Alertes de crédit (15 / 10 / 5 / 3 / 1 %) : un canal vide est simplement ignoré ---
# E-mail via Gmail : adresse + « mot de passe d'application » Google (pas le mot de passe du compte)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# WhatsApp : soit Twilio (numéro expéditeur WhatsApp), soit Meta Cloud API (prioritaire si renseignée)
TWILIO_WHATSAPP_FROM=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Modèle Meta approuvé à un paramètre (obligatoire hors fenêtre de 24 h), sinon message texte libre
WHATSAPP_TEMPLATE_NAME=

# Assistant IA (laisser vide : moteur de règles sur les données réelles)
DEEPSEEK_API_KEY=
